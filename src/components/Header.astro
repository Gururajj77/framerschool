---
import { YOUTUBE_URL } from '../config';

const links = [
  { href: '#method', label: 'Method' },
  { href: '#builds', label: 'Builds' },
  { href: '#learn', label: 'Learn' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="fs-nav" data-topbar data-nav>
  <div class="fs-nav-inner">
    <a href="#home" class="fs-nav-brand" aria-label="FramerSchool home">
      <img src="/brand/fs-logo.svg" width="28" height="30" alt="" class="fs-nav-mark" decoding="async" />
      <span class="fs-nav-name">FramerSchool</span>
    </a>

    <nav class="fs-nav-links" aria-label="Main" data-site-nav>
      {links.map((link) => (
        <a href={link.href} class="fs-nav-link pf-topbar-link">{link.label}</a>
      ))}
    </nav>

    <div class="fs-nav-end">
      <a href={YOUTUBE_URL} class="fs-nav-cta" target="_blank" rel="noopener noreferrer">Watch</a>
      <button
        class="fs-nav-burger"
        data-nav-toggle
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="fs-nav-sheet" id="nav-overlay" data-nav-overlay aria-hidden="true">
  <nav class="fs-nav-sheet-nav" aria-label="Mobile">
    {links.map((link) => (
      <a href={link.href} data-nav-overlay-link>{link.label}</a>
    ))}
    <a href={YOUTUBE_URL} data-nav-overlay-link target="_blank" rel="noopener noreferrer">Watch builds</a>
  </nav>
</div>
