---
import Wordmark from './Wordmark.astro';
import { YOUTUBE_URL } from '../config';

const links = [
  { href: '#method', label: 'Method' },
  { href: '#pillars', label: 'Pillars' },
  { href: '#builds', label: 'Builds' },
  { href: '#philosophy', label: 'Philosophy' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="pf-topbar" data-topbar>
  <div class="pf-container pf-topbar-inner">
    <a href="#home" class="pf-topbar-brand" aria-label="FramerSchool home">
      <Wordmark size="sm" />
    </a>

    <nav class="pf-topbar-nav" id="site-nav" aria-label="Main" data-site-nav>
      {links.map((link) => (
        <a href={link.href} class="pf-topbar-link" data-nav-label={link.label}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="pf-topbar-actions">
      <a href={YOUTUBE_URL} class="pf-topbar-mail" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href={YOUTUBE_URL} class="pf-btn pf-btn--primary pf-btn--sm" target="_blank" rel="noopener noreferrer">
        Watch builds
      </a>
      <button
        class="pf-topbar-toggle"
        data-nav-toggle
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="pf-nav-overlay" id="nav-overlay" data-nav-overlay aria-hidden="true">
  <div class="pf-nav-overlay-inner">
    <nav class="pf-nav-overlay-nav" aria-label="Mobile">
      {links.map((link) => (
        <a href={link.href} class="pf-nav-overlay-link" data-nav-overlay-link>
          {link.label}
        </a>
      ))}
      <a href={YOUTUBE_URL} class="pf-nav-overlay-link" data-nav-overlay-link target="_blank" rel="noopener noreferrer">
        Watch builds
      </a>
    </nav>
  </div>
</div>
