---
const steps = [
  {
    number: '01',
    title: 'Pick a template',
    text: 'Start with a layout that matches the business — not the flashiest file in the marketplace.',
  },
  {
    number: '02',
    title: 'Choose a real niche',
    text: 'Law firm, dentist, gym, SaaS, restaurant. Real client work starts with a real business.',
  },
  {
    number: '03',
    title: 'Convert for production',
    text: 'Cut what does not fit. Rebuild structure, components, CMS, assets, and performance.',
  },
  {
    number: '04',
    title: 'Explain every decision',
    text: 'Why this section exists. Why the content model looks like this. Why naming matters.',
  },
];
---

<section id="method" class="fs-band">
  <div class="fs-wrap">
    <div class="fs-split-head">
      <h2 class="fs-display">How every<br />build works</h2>
      <p class="fs-lede">
        Every video follows the same pattern. That is what real client work looks like —
        templates adapted with intent, not blank-canvas demos.
      </p>
    </div>

    <div class="fs-method" data-method>
      <div class="fs-method-track" aria-hidden="true">
        <div class="fs-method-progress" data-method-progress></div>
      </div>
      <ol class="fs-method-steps">
        {steps.map((step) => (
          <li class="fs-method-step" data-method-step>
            <span class="fs-method-num">{step.number}</span>
            <h3 class="fs-method-title">{step.title}</h3>
            <p class="fs-method-text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
