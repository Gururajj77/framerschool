---
import { YOUTUBE_URL, CONTACT_EMAIL } from '../config';
import SectionHead from './SectionHead.astro';
---

<section id="watch" class="pf-section pf-section--cta">
  <div class="pf-container pf-cta">
    <SectionHead
      tag="WATCH"
      title="Watch the builds"
      lead="See templates become production-ready client websites — with every important decision explained along the way."
    />

    <div class="pf-cta-actions" data-cta-panel>
      <a href={YOUTUBE_URL} class="pf-btn pf-btn--primary pf-btn--lg" target="_blank" rel="noopener noreferrer">
        Open YouTube
      </a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="pf-btn pf-btn--outline pf-btn--lg">Email FramerSchool</a>
    </div>
  </div>
</section>
