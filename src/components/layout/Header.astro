---
import { FACES, YOUTUBE_URL } from '../../config';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo />

    <!-- On the home page these turn the cube; elsewhere they go home to that face -->
    <nav class="face-nav" aria-label="Faces" data-face-nav>
      <ol role="list" class="face-nav-list">
        {FACES.map((face, i) => (
          <li>
            <a
              href={`/#${face.id}`}
              class="face-nav-link t-label"
              style={`--face-color: var(--${face.color})`}
              data-face-link={face.id}
            >
              <span class="face-nav-swatch" aria-hidden="true"></span>
              <span class="face-nav-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {face.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="site-header-end">
      <button type="button" class="square-button theme-toggle" aria-pressed="false" data-theme-toggle>
        <span class="sr-only">Dark mode</span>
        <!-- Moon in light mode, sun in dark mode -->
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M14.5 11.2A6.5 6.5 0 0 1 6.8 3.5a6.5 6.5 0 1 0 7.7 7.7Z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <rect x="5.5" y="5.5" width="7" height="7" fill="currentColor" />
          <path d="M9 0.5v3M9 14.5v3M0.5 9h3M14.5 9h3M3 3l2 2M13 13l2 2M3 15l2-2M13 5l2-2" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
      <Button href={YOUTUBE_URL} label="Watch builds" external compact class="site-header-cta" />
    </div>
  </div>
</header>
