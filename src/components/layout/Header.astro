---
import { NAV_LINKS, YOUTUBE_URL } from '../../config';
import Logo from '../ui/Logo.astro';
import NavLink from '../ui/NavLink.astro';
import ArrowLink from '../ui/ArrowLink.astro';

interface Props {
  /** Float the header over the first section on desktop (home hero). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', overlay && 'site-header--overlay']} data-header>
  <div class="container site-header-inner">
    <nav class="site-nav" aria-label="Main">
      <ul role="list" class="site-nav-list">
        {NAV_LINKS.map((link) => (
          <li data-intro="nav">
            <NavLink href={link.href} label={link.label} />
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header-logo" data-intro="nav">
      <Logo />
    </div>

    <div class="site-header-end" data-intro="nav">
      <ArrowLink href={YOUTUBE_URL} label="Watch builds" external class="site-header-cta" />
      <button
        type="button"
        class="menu-toggle"
        data-menu-open
        aria-expanded="false"
        aria-controls="menu-sheet"
      >
        <span class="sr-only">Open menu</span>
        <span class="menu-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div
  class="menu-sheet"
  id="menu-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  data-menu
  hidden
>
  <div class="container menu-sheet-top">
    <Logo />
    <button type="button" class="menu-toggle" data-menu-close>
      <span class="sr-only">Close menu</span>
      <span class="menu-close-icon" aria-hidden="true"></span>
    </button>
  </div>
  <nav class="menu-sheet-nav" aria-label="Mobile">
    <ul role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <NavLink href={link.href} label={link.label} size="large" class="nav-link--bright" />
        </li>
      ))}
      <li>
        <NavLink href={YOUTUBE_URL} label="Watch builds" external size="large" class="nav-link--bright" />
      </li>
    </ul>
  </nav>
</div>
