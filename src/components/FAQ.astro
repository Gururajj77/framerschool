---
import SectionHead from './SectionHead.astro';

const faqs = [
  {
    question: 'Is this for complete beginners?',
    answer:
      'No. FramerSchool assumes you already know enough to build something. We teach how professionals structure projects, model content, and deliver client-ready sites.',
  },
  {
    question: 'Do I need to design from scratch?',
    answer:
      'No. Real client work usually starts with a template. The skill is adapting it — cutting what does not fit, rebuilding structure, and shipping something a client would pay for.',
  },
  {
    question: 'What do you actually teach?',
    answer:
      'Architecture, CMS design, reusable systems, client workflows, performance, and the decisions behind every major choice while converting a template into a production site.',
  },
  {
    question: 'Is this another Framer feature channel?',
    answer:
      'No. Features change. Systems thinking does not. Framer is the tool — professional website building is the subject.',
  },
];
---

<section id="faq" class="pf-section">
  <div class="pf-container">
    <SectionHead
      tag="FAQ"
      title="Who this is for"
      lead="Quick filters so you know if FramerSchool matches how you want to work."
    />

    <div class="pf-faq-list" role="list">
      {faqs.map((faq) => (
        <div class="pf-faq-item" data-faq-item role="listitem">
          <h3 class="pf-faq-heading">
            <button class="pf-faq-trigger" data-faq-toggle type="button" aria-expanded="false">
              <span class="pf-faq-qmark" aria-hidden="true">/</span>
              <span class="pf-faq-question-text">{faq.question}</span>
              <span class="pf-faq-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </button>
          </h3>
          <div class="pf-faq-panel" data-faq-panel>
            <div class="pf-faq-panel-inner">
              <p>{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
