---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href: string;
  label: string;
  external?: boolean;
  class?: string;
}

const { href, label, external = false, class: className } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class:list={['arrow-link', 't-label', className]} {...externalAttrs}>
  <span class="arrow-link-icon arrow-link-icon--start"><ArrowIcon /></span>
  <span>{label}</span>
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  <span class="arrow-link-icon arrow-link-icon--end"><ArrowIcon /></span>
</a>
