---
/** Underlined mono text link. */
interface Props {
  href: string;
  label: string;
  external?: boolean;
  class?: string;
}

const { href, label, external = false, class: className } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class:list={['text-link', 't-label', className]} {...externalAttrs}>
  {label}{external && <span aria-hidden="true"> ↗</span>}
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
