---
/**
 * Chunky button with a hard shadow that presses in on hover.
 * Pass `face` to turn the cube to that face instead of navigating.
 */
interface Props {
  label: string;
  href?: string;
  face?: string;
  external?: boolean;
  color?: 'yellow' | 'white' | 'ink';
  /** Hide the text visually below 768px (the arrow stays). */
  compact?: boolean;
  class?: string;
}

const { label, href, face, external = false, color = 'yellow', compact = false, class: className } = Astro.props;
const target = face ? `/#${face}` : href;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={target}
  class:list={['btn', `btn--${color}`, compact && 'btn--compact', className]}
  data-face-link={face}
  {...externalAttrs}
>
  <span class="btn-label">{label}</span>
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    {external ? (
      <path d="M4 12 12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" />
    ) : (
      <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" />
    )}
  </svg>
</a>
