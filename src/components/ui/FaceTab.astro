---
import { FACES, faceNumber, type FaceId } from '../../config';

/** Black sticker at the top of every face: "01 / INDEX". */
interface Props {
  id: FaceId;
}

const { id } = Astro.props;
const label = FACES.find((face) => face.id === id)?.label ?? id;
---

<p class="face-tab t-label">
  <span>{faceNumber(id)}</span>
  <span class="face-tab-slash" aria-hidden="true">/</span>
  <span>{label}</span>
</p>
