---
const pillars = [
  {
    number: '01',
    title: 'Website builds',
    text: 'Turn templates into production-ready sites for real businesses — restaurant, gym, startup, dentist, and more.',
  },
  {
    number: '02',
    title: 'Architecture',
    text: 'Project organization, component hierarchy, folder structure, design systems, and reusable systems.',
  },
  {
    number: '03',
    title: 'CMS',
    text: 'Content modeling, collections, naming conventions, scaling content, and dynamic pages.',
  },
  {
    number: '04',
    title: 'Professional workflow',
    text: 'Client handoff, asset organization, faster builds, fewer revisions, less maintenance.',
  },
  {
    number: '05',
    title: 'Performance',
    text: 'Image optimization, lazy loading, SEO, accessibility, and faster page loads.',
  },
];
---

<section id="learn" class="fs-band fs-band--paper">
  <div class="fs-wrap">
    <div class="fs-split-head">
      <h2 class="fs-display">What you<br />actually learn</h2>
      <p class="fs-lede">
        Five pillars. One focus: systems thinking over software features.
      </p>
    </div>
  </div>

  <div class="fs-pillars" data-pillars>
    {pillars.map((pillar) => (
      <article class="fs-pillar" data-pillar>
        <div class="fs-wrap fs-pillar-inner">
          <span class="fs-pillar-num">{pillar.number}</span>
          <div class="fs-pillar-body">
            <h3 class="fs-pillar-title">{pillar.title}</h3>
            <p class="fs-pillar-text">{pillar.text}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
