---
import FaceTab from '../ui/FaceTab.astro';

const pillars = [
  { title: 'Website builds', text: 'Production-ready sites for real businesses: restaurant, gym, startup, dentist.' },
  { title: 'Architecture', text: 'Project organization, component hierarchy, folders and design systems.' },
  { title: 'CMS', text: 'Content modeling, collections, naming, scaling content and dynamic pages.' },
  { title: 'Professional workflow', text: 'Client handoff, organized assets, faster builds and fewer revisions.' },
  { title: 'Performance', text: 'Image optimization, lazy loading, SEO, accessibility and fast loads.' },
];
---

<section
  class="face face--pink face--side face--learn"
  id="learn"
  data-face="learn"
  data-face-label="Learn"
  aria-labelledby="learn-title"
  tabindex="-1"
>
  <FaceTab id="learn" />

  <div class="face-body">
    <h2 class="face-title" id="learn-title">What you learn.</h2>
    <p class="face-lead">Five pillars, one focus: systems thinking over software features.</p>

    <ol role="list" class="table">
      {pillars.map((pillar, i) => (
        <li class="table-row">
          <span class="table-tile" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="table-title">{pillar.title}</h3>
          <p class="table-text">{pillar.text}</p>
        </li>
      ))}
    </ol>

    <p class="face-stamp t-label">Leave knowing why, not where the button is.</p>
  </div>
</section>
