---
import { YOUTUBE_URL } from '../../config';
import FaceTab from '../ui/FaceTab.astro';
import Button from '../ui/Button.astro';

const facts = [
  { value: '04', label: 'Steps per build' },
  { value: '07', label: 'Real niches' },
  { value: '05', label: 'Core pillars' },
];
---

<section
  class="face face--red face--side face--index"
  id="index"
  data-face="index"
  data-face-label="Index"
  aria-labelledby="index-title"
  tabindex="-1"
>
  <FaceTab id="index" />
  <p class="sticker sticker--corner t-label" aria-hidden="true">Not a feature tour</p>

  <div class="face-body index-body">
    <div class="index-copy">
      <p class="face-kicker t-label">Learn to turn</p>
      <h1 class="index-title" id="index-title">Templates into production-ready client websites.</h1>
      <p class="face-lead">Architecture, workflows, CMS and professional delivery, explained one real build at a time.</p>
    </div>

    <div class="face-actions">
      <Button href={YOUTUBE_URL} label="Watch builds" external />
      <Button face="method" label="How it works" color="white" />
    </div>

    <ul role="list" class="index-facts">
      {facts.map((fact) => (
        <li class="index-fact">
          <strong>{fact.value}</strong>
          <span class="t-label">{fact.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
