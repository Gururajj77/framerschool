---
import FaceTab from '../ui/FaceTab.astro';

const niches = [
  { name: 'Law firm', detail: 'Authority, service architecture and a CMS partners can maintain.' },
  { name: 'Dentist', detail: 'Local intent first. Offers, providers and booking as a system.' },
  { name: 'Gym', detail: 'Memberships, coaches and schedules that scale without redesign.' },
  { name: 'Coffee shop', detail: 'Menu as CMS. Locations as structure. Brand without the bloat.' },
  { name: 'SaaS', detail: 'Reusable landing modules, pricing logic, a path that survives change.' },
  { name: 'Agency', detail: 'Case study architecture, clear process, an intentional lead path.' },
  { name: 'Restaurant', detail: 'Menus that update cleanly. Hours and reservations as content.' },
];
---

<section
  class="face face--blue face--side face--niches"
  id="niches"
  data-face="niches"
  data-face-label="Niches"
  aria-labelledby="niches-title"
  tabindex="-1"
>
  <FaceTab id="niches" />

  <div class="face-body">
    <h2 class="face-title" id="niches-title">Real niches. Real client work.</h2>
    <p class="face-lead">The value comes from adapting templates, not designing from a blank canvas.</p>

    <ol role="list" class="table">
      {niches.map((niche, i) => (
        <li class="table-row">
          <span class="table-number t-label" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="table-title">{niche.name}</h3>
          <p class="table-text">{niche.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
