---
import FaceTab from '../ui/FaceTab.astro';

const steps = [
  {
    title: 'Pick a template',
    text: 'Start with a layout that matches the business, not the flashiest file in the marketplace.',
  },
  {
    title: 'Choose a real niche',
    text: 'Law firm, dentist, gym, SaaS, restaurant. Real client work starts with a real business.',
  },
  {
    title: 'Convert for production',
    text: 'Cut what does not fit. Rebuild structure, components, CMS, assets and performance.',
  },
  {
    title: 'Explain every decision',
    text: 'Why this section exists. Why the content model looks like this. Why naming matters.',
  },
];
---

<section
  class="face face--yellow face--side face--method"
  id="method"
  data-face="method"
  data-face-label="Method"
  aria-labelledby="method-title"
  tabindex="-1"
>
  <FaceTab id="method" />

  <div class="face-body">
    <h2 class="face-title" id="method-title">
      Most creators teach features. We teach how pros build websites.
    </h2>
    <p class="face-lead">Every build on the channel follows the same four steps.</p>

    <ol role="list" class="cards">
      {steps.map((step, i) => (
        <li class="card">
          <div class="card-head">
            <span class="card-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card-title">
              <span class="sr-only">Step {i + 1}: </span>{step.title}
            </h3>
          </div>
          <p class="card-text">{step.text}</p>
        </li>
      ))}
    </ol>

    <p class="face-stamp t-label">Teach decisions, not clicks. Framer is simply the tool.</p>
  </div>
</section>
