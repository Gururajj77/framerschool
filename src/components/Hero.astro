---
import { YOUTUBE_URL } from '../config';
---

<section id="home" class="fs-hero" data-hero>
  <div class="fs-hero-field">
    <div class="fs-hero-copy">
      <p class="fs-hero-brand" data-hero-brand>
        <img src="/brand/fs-logo.svg" width="48" height="52" alt="" class="fs-hero-mark" decoding="async" />
        <span>FramerSchool</span>
      </p>

      <h1 class="fs-hero-title" data-hero-title>
        Turn templates into<br />production-ready<br />client websites
      </h1>

      <p class="fs-hero-lead" data-hero-lead>
        Architecture, workflows, CMS, and professional delivery — not feature tours.
      </p>

      <div class="fs-hero-actions" data-hero-actions>
        <a href={YOUTUBE_URL} class="fs-btn fs-btn--ink" target="_blank" rel="noopener noreferrer">
          Watch builds
        </a>
        <a href="#method" class="fs-btn fs-btn--ghost-light">How it works</a>
      </div>
    </div>

    <div class="fs-hero-visual" aria-hidden="true" data-hero-board>
      <div class="fs-hero-wire" data-hero-wire>
        <div class="fs-wire-col">
          <span class="fs-wire-label">Template</span>
          <div class="fs-wire-frame">
            <i class="fs-wire-bar"></i>
            <i class="fs-wire-bar fs-wire-bar--mid"></i>
            <i class="fs-wire-bar fs-wire-bar--short"></i>
            <div class="fs-wire-cells">
              <i></i><i></i><i></i>
            </div>
          </div>
        </div>
        <div class="fs-wire-flow">
          <span class="fs-wire-arrow"></span>
        </div>
        <div class="fs-wire-col fs-wire-col--live">
          <span class="fs-wire-label" data-wire-niche>Law firm</span>
          <div class="fs-wire-frame fs-wire-frame--live">
            <i class="fs-wire-bar"></i>
            <i class="fs-wire-bar fs-wire-bar--mid"></i>
            <i class="fs-wire-bar fs-wire-bar--short"></i>
            <div class="fs-wire-cells">
              <i></i><i></i>
            </div>
          </div>
        </div>
      </div>
      <p class="fs-hero-caption">Template → niche → ship</p>
    </div>
  </div>
</section>
