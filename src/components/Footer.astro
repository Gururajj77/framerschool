---
import { YOUTUBE_URL, CONTACT_EMAIL } from '../config';
import Wordmark from './Wordmark.astro';

const pageLinks = [
  { href: '#home', label: 'Home' },
  { href: '#method', label: 'Method' },
  { href: '#pillars', label: 'Pillars' },
  { href: '#builds', label: 'Builds' },
  { href: '#faq', label: 'FAQ' },
];

const legalLinks = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="pf-footer">
  <div class="pf-container pf-footer-inner">
    <div class="pf-footer-brand">
      <Wordmark size="sm" />
      <p class="pf-footer-tagline">
        FramerSchool teaches developers, freelancers, and agencies how to turn Framer templates into
        production-ready client websites.
      </p>
    </div>

    <div class="pf-footer-col">
      <p class="pf-footer-label">Pages</p>
      <nav class="pf-footer-nav" aria-label="Footer pages">
        {pageLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer">YouTube</a>
      </nav>
    </div>

    <div class="pf-footer-col">
      <p class="pf-footer-label">Contact</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="pf-footer-contact">{CONTACT_EMAIL}</a>
      <nav class="pf-footer-legal" aria-label="Legal">
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>

    <p class="pf-footer-copy">&copy; 2026 FramerSchool. All rights reserved.</p>
  </div>
</footer>
