---
import { YOUTUBE_URL, CONTACT_EMAIL } from '../config';

const pageLinks = [
  { href: '#method', label: 'Method' },
  { href: '#builds', label: 'Builds' },
  { href: '#learn', label: 'Learn' },
  { href: '#faq', label: 'FAQ' },
  { href: YOUTUBE_URL, label: 'YouTube', external: true },
];

const legalLinks = [
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="fs-footer">
  <div class="fs-wrap fs-footer-inner">
    <div class="fs-footer-brand">
      <p class="fs-footer-name">FramerSchool</p>
      <p class="fs-footer-tag">
        Turn Framer templates into production-ready client websites.
      </p>
    </div>

    <nav class="fs-footer-nav" aria-label="Footer">
      {pageLinks.map((link) =>
        link.external ? (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        ) : (
          <a href={link.href}>{link.label}</a>
        )
      )}
      {legalLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="fs-footer-meta">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <p>&copy; 2026 FramerSchool</p>
    </div>
  </div>
</footer>
