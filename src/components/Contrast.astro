---
import SectionHead from './SectionHead.astro';
---

<section id="contrast" class="pf-section pf-section--muted">
  <div class="pf-container">
    <SectionHead
      tag="POSITIONING"
      title="Most creators teach Framer. We teach professional website building."
      lead="Someone who watches should leave thinking: now I know why professionals structure projects this way — not where the CMS button is."
    />

    <div class="pf-contrast" data-contrast>
      <article class="pf-contrast-col" data-contrast-cell>
        <p class="pf-contrast-label">Typical Framer content</p>
        <ul class="pf-contrast-list">
          <li>Animations and UI tricks</li>
          <li>New feature walkthroughs</li>
          <li>Blank-canvas recreation</li>
          <li>Clicks without context</li>
        </ul>
      </article>
      <article class="pf-contrast-col pf-contrast-col--accent" data-contrast-cell>
        <p class="pf-contrast-label">FramerSchool</p>
        <ul class="pf-contrast-list">
          <li>Project architecture</li>
          <li>CMS organization that scales</li>
          <li>Template → client delivery</li>
          <li>Decisions you can defend</li>
        </ul>
      </article>
    </div>
  </div>
</section>
