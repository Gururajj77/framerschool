---
import '../styles/site/index.css';

interface Props {
  title?: string;
  description?: string;
  /** "cube": the home page, which turns instead of scrolling. "page": a normal scrolling page. */
  variant?: 'cube' | 'page';
}

const {
  title = 'FramerSchool: turn templates into production-ready client websites',
  description =
    'FramerSchool teaches developers, freelancers and agencies how to turn Framer templates into production-ready client websites: architecture, workflows, CMS and professional delivery.',
  variant = 'page',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fff4e0" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/fs-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ variant }}>
      // Set before first paint so the page never flashes as a stacked list.
      // Screens under 500px tall (phones in landscape) keep the stacked page.
      var root = document.documentElement;
      root.classList.add('js');
      if (variant === 'cube' && window.matchMedia('(min-height: 500px)').matches) {
        root.classList.add('cube-mode');
      }

      // Theme: the visitor's saved choice, otherwise the device setting
      var saved = null;
      try {
        saved = localStorage.getItem('fs-theme');
      } catch (e) {}
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'dark' : 'light';
      var themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', dark ? '#121212' : '#fff4e0');
    </script>
  </head>
  <body data-variant={variant}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      import '../scripts/site/main.ts';
    </script>
  </body>
</html>
