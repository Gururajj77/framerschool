---
import Layout from './Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import NavLink from '../components/ui/NavLink.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={`${title}: FramerSchool`} description={description}>
  <Header />
  <main id="main" class="legal">
    <div class="legal-inner">
      <NavLink href="/" label="Back to the cube" />
      <h1 class="legal-title t-display">{title}</h1>
      <div class="legal-content t-body-m">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
